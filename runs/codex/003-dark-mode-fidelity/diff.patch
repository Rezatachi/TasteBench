+        : uiColor(0.18, 0.15, 0.12, 0.07)
+    })
+
+    static func moodTint(for mood: Mood) -> Color {
+        Color(UIColor { trait in
+            let isDark = trait.userInterfaceStyle == .dark
+
+            switch mood {
+            case .calm:
+                return isDark
+                ? uiColor(0.55, 0.67, 0.61)
+                : uiColor(0.43, 0.57, 0.52)
+            case .grateful:
+                return isDark
+                ? uiColor(0.77, 0.58, 0.39)
+                : uiColor(0.71, 0.49, 0.28)
+            case .anxious:
+                return isDark
+                ? uiColor(0.70, 0.61, 0.77)
+                : uiColor(0.61, 0.50, 0.73)
+            case .focused:
+                return isDark
+                ? uiColor(0.53, 0.62, 0.76)
+                : uiColor(0.38, 0.49, 0.66)
+            case .tired:
+                return isDark
+                ? uiColor(0.66, 0.62, 0.55)
+                : uiColor(0.55, 0.52, 0.47)
+            case .hopeful:
+                return isDark
+                ? uiColor(0.66, 0.70, 0.43)
+                : uiColor(0.55, 0.60, 0.34)
+            }
+        })
+    }
+
+    private static func uiColor(_ red: Float, _ green: Float, _ blue: Float, _ alpha: Float = 1.0) -> UIColor {
+        UIColor(_colorLiteralRed: red, green: green, blue: blue, alpha: alpha)
+    }
 }
